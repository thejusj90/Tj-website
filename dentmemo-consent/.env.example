# Public app configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_CLINIC_NAME=Your Dental Clinic
NEXT_PUBLIC_CLINIC_EMAIL=doctor@example.com

# Supabase (recommended for production persistence)
NEXT_PUBLIC_SUPABASE_URL=
# Anon/publishable key — safe for the browser. Used for magic-link sign-in.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Every signed-in user is added to this one seeded clinic via
# app/api/auth/bootstrap (invite-gated by the clinic_invites table). Leave
# unset to use the demo clinic seeded by supabase/schema.sql. Real
# multi-clinic onboarding is still a later phase.
DEFAULT_CLINIC_ID=00000000-0000-0000-0000-000000000001

# Resend (optional email delivery)
RESEND_API_KEY=
CONSENT_FROM_EMAIL=consent@your-verified-domain.com
